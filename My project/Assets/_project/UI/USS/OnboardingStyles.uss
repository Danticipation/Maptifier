/* Onboarding-specific styles for Maptifier - Polish Pass */

/* ========== Page Layout ========== */
.maptifier-onboard-page {
    width: 100%;
    height: 100%;
    padding: 40px;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    flex-grow: 0;
}

.maptifier-onboard-content {
    max-width: 480px;
    align-items: center;
    justify-content: center;
}

.maptifier-onboard-image {
    width: 200px;
    height: 200px;
    margin-bottom: 40px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale, rotate;
    transition-duration: 0.6s;
    transition-timing-function: ease-out-back;
}

.maptifier-onboard-page:active .maptifier-onboard-image {
    scale: 1.1;
}

.maptifier-onboard-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--maptifier-text-primary);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.maptifier-onboard-desc {
    font-size: 16px;
    color: var(--maptifier-text-secondary);
    -unity-text-align: middle-center;
    white-space: normal;
    line-height: 24px;
}

/* ========== Step Indicators ========== */
.maptifier-step-container {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 32px;
}

.maptifier-step-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: var(--maptifier-bg-tertiary);
    margin: 0 6px;
    border-width: 1px;
    border-color: var(--maptifier-border);
    transition-property: background-color, scale;
    transition-duration: 0.3s;
}

.maptifier-step-dot--active {
    background-color: var(--maptifier-accent-cyan);
    scale: 1.3;
    border-color: var(--maptifier-accent-cyan);
    box-shadow: 0 0 10px var(--maptifier-accent-cyan);
}

/* ========== Navigation ========== */
.maptifier-onboard-nav {
    position: absolute;
    bottom: 40px;
    left: 40px;
    right: 40px;
    height: 64px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.maptifier-onboard-btn {
    height: 56px;
    padding: 0 32px;
    border-radius: 28px;
    font-size: 16px;
    -unity-font-style: bold;
    background-color: var(--maptifier-bg-tertiary);
    border-width: 1px;
    border-color: var(--maptifier-border);
    transition-property: background-color, scale;
    transition-duration: 0.1s;
}

.maptifier-onboard-btn:active {
    scale: 0.95;
    background-color: var(--maptifier-bg-secondary);
}

.maptifier-onboard-btn--primary {
    background-color: var(--maptifier-accent-cyan);
    color: var(--maptifier-bg-primary);
    border-width: 0;
}

.maptifier-onboard-btn--primary:active {
    background-color: #00B4D8;
}
