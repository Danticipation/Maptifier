/* Maptifier Dark Theme - Production Grade Polish */

/* ========== Root Variables ========== */
:root {
    --maptifier-bg-primary: #0D1117;
    --maptifier-bg-secondary: #161B22;
    --maptifier-bg-tertiary: #21262D;
    --maptifier-accent-cyan: #00D4FF;
    --maptifier-accent-cyan-dim: rgba(0, 212, 255, 0.15);
    --maptifier-accent-magenta: #FF2D78;
    --maptifier-accent-green: #3FB950;
    --maptifier-text-primary: #E6EDF3;
    --maptifier-text-secondary: #8B949E;
    --maptifier-text-disabled: #484F58;
    --maptifier-border: #30363D;
    --maptifier-danger: #F85149;
    --maptifier-warning: #D29922;
    --maptifier-success: #3FB950;
    --maptifier-radius: 12px;
    --maptifier-radius-sm: 8px;
    --maptifier-touch-target: 56px;

    /* Animation Durations */
    --maptifier-anim-fast: 0.1s;
    --maptifier-anim-med: 0.25s;
}

/* ========== Base Element Styles ========== */
.maptifier-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--maptifier-bg-primary);
    width: 100%;
    height: 100%;
}

.maptifier-topbar {
    height: 56px;
    background-color: var(--maptifier-bg-secondary);
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    border-bottom-width: 1px;
    border-bottom-color: var(--maptifier-border);
}

.maptifier-canvas-area {
    flex-grow: 1;
    background-color: #000000;
}

/* Glassmorphism Sidebar Effect */
.maptifier-sidebar {
    position: absolute;
    left: 12px;
    top: 68px;
    bottom: 88px;
    width: 64px;
    background-color: rgba(22, 27, 34, 0.85);
    border-radius: 32px;
    border-width: 1px;
    border-color: var(--maptifier-border);
    padding: 8px;
    flex-direction: column;
    justify-content: space-around;
    align-items: center;
}

/* ========== Toolbar (Bottom) ========== */
.maptifier-toolbar {
    height: 80px;
    background-color: var(--maptifier-bg-secondary);
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    border-top-width: 1px;
    border-top-color: var(--maptifier-border);
    padding-bottom: env(safe-area-inset-bottom);
}

.maptifier-toolbar__button {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background-color: transparent;
    transition-property: background-color, scale, border-color;
    transition-duration: var(--maptifier-anim-fast);
    border-width: 1px;
    border-color: transparent;
    justify-content: center;
    align-items: center;
}

.maptifier-toolbar__button:hover {
    background-color: var(--maptifier-bg-tertiary);
}

.maptifier-toolbar__button:active {
    scale: 0.9;
    background-color: var(--maptifier-accent-cyan-dim);
}

.maptifier-toolbar__button--active {
    background-color: var(--maptifier-accent-cyan-dim);
    border-color: var(--maptifier-accent-cyan);
    border-width: 1.5px;
}

.maptifier-toolbar__icon {
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: var(--maptifier-text-primary);
}

.maptifier-toolbar__button--active .maptifier-toolbar__icon {
    -unity-background-image-tint-color: var(--maptifier-accent-cyan);
}

/* ========== Drawer (Layers) ========== */
.maptifier-drawer {
    position: absolute;
    right: 0;
    top: 56px;
    bottom: 80px;
    width: 320px;
    background-color: var(--maptifier-bg-secondary);
    border-left-width: 1px;
    border-left-color: var(--maptifier-border);
    translate: 320px 0;
    transition-property: translate;
    transition-duration: var(--maptifier-anim-med);
    transition-timing-function: ease-out-back;
}

.maptifier-drawer--open {
    translate: 0 0;
}

/* ========== Toasts ========== */
.maptifier-toast {
    position: absolute;
    bottom: 100px;
    align-self: center;
    background-color: #21262D;
    border-width: 1px;
    border-color: var(--maptifier-border);
    padding: 12px 24px;
    border-radius: 24px;
    opacity: 0;
    translate: 0 20px;
    transition-property: opacity, translate;
    transition-duration: 0.3s;
    color: var(--maptifier-text-primary);
    font-size: 14px;
    -unity-font-style: bold;
}

.maptifier-toast--visible {
    opacity: 1;
    translate: 0 0;
}

/* ========== Connectivity Status ========== */
.maptifier-status-container {
    flex-direction: row;
    align-items: center;
    background-color: var(--maptifier-bg-tertiary);
    padding: 4px 12px;
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--maptifier-border);
}

.maptifier-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 8px;
}

.maptifier-status-dot--connected {
    background-color: var(--maptifier-success);
    box-shadow: 0 0 8px var(--maptifier-success);
}

.maptifier-status-dot--disconnected {
    background-color: var(--maptifier-danger);
}

/* ========== Advanced Sliders ========== */
.maptifier-slider {
    height: 40px;
    margin-bottom: 8px;
}

.maptifier-slider .unity-base-slider__tracker {
    height: 4px;
    background-color: var(--maptifier-bg-tertiary);
    border-radius: 2px;
    border-width: 0;
}

.maptifier-slider .unity-base-slider__dragger {
    width: 24px;
    height: 24px;
    background-color: var(--maptifier-text-primary);
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--maptifier-accent-cyan);
    margin-top: -10px;
}

.maptifier-slider:active .unity-base-slider__dragger {
    scale: 1.2;
    background-color: var(--maptifier-accent-cyan);
}

/* ========== Cards & Panels ========== */
.maptifier-card {
    background-color: var(--maptifier-bg-tertiary);
    border-radius: var(--maptifier-radius);
    padding: 16px;
    margin-bottom: 12px;
    border-width: 1px;
    border-color: var(--maptifier-border);
}

.maptifier-card--active {
    border-color: var(--maptifier-accent-cyan);
    background-color: var(--maptifier-accent-cyan-dim);
}

/* Typography Overrides */
.unity-label {
    color: var(--maptifier-text-primary);
}

.maptifier-header {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.maptifier-subheader {
    font-size: 12px;
    color: var(--maptifier-text-secondary);
    margin-bottom: 12px;
}
